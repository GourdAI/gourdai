{
  "appId": "org.noear.gourd-ai-desktop",
  "productName": "Gourd AI",
  "copyright": "Copyright © 2026 noear.org",
  "directories": {
    "output": "out"
  },
  "files": [
    "main/**/*",
    "loading.html"
  ],
  "extraResources": [
    {
      "from": "build/extraResources/",
      "to": "extraResources",
      "filter": ["**/*", "!.gourdai", "!.gourdai/**"]
    },
    {
      "from": "build/ui/",
      "to": "ui"
    },
    {
      "from": "build/icons/",
      "to": "icons"
    }
  ],
  "afterPack": "cmd/afterPack.js",
  "mac": {
    "icon": "build/icons/icon.png",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.developer-tools",
    "minimumSystemVersion": "11.0"
  }
}
