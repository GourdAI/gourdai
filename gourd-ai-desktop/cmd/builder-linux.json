{
  "appId": "org.noear.gourd-ai-desktop",
  "productName": "GWork",
  "copyright": "Copyright © 2026 noear.org",
  "directories": {
    "output": "out"
  },
  "publish": {
    "provider": "generic",
    "url": "https://www.gourd-ai.cn/desktop/latest/",
    "channel": "latest"
  },
  "files": [
    "main/**/*",
    "loading.html"
  ],
  "extraResources": [
    {
      "from": "build/extraResources/",
      "to": "extraResources",
      "filter": ["**/*", "!.gwork", "!.gwork/**", "!.gourdai", "!.gourdai/**"]
    },
    {
      "from": "build/ui/",
      "to": "ui"
    }
  ],
  "linux": {
    "icon": "build/icons/",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Development"
  }
}
