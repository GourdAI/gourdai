{
  "appId": "org.noear.gourd-ai-desktop",
  "productName": "Gourd AI",
  "copyright": "Copyright © 2026 noear.org",
  "directories": {
    "output": "out"
  },
  "files": [
    "main/**/*",
    "loading.html"
  ],
  "extraResources": [
    {
      "from": "build/extraResources/",
      "to": "extraResources",
      "filter": ["**/*", "!.gourdai", "!.gourdai/**"]
    },
    {
      "from": "build/ui/",
      "to": "ui"
    }
  ],
  "linux": {
    "icon": "build/icons/",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Development"
  }
}
