{
  "appId": "org.noear.gourd-ai-desktop",
  "productName": "GWork",
  "copyright": "Copyright © 2026 noear.org",
  "directories": {
    "output": "out"
  },
  "publish": {
    "provider": "generic",
    "url": "https://www.gourd-ai.cn/desktop/latest/",
    "channel": "latest"
  },
  "files": [
    "main/**/*",
    "loading.html"
  ],
  "extraResources": [
    {
      "from": "build/extraResources/",
      "to": "extraResources",
      "filter": ["**/*", "!.gwork", "!.gwork/**", "!.gourdai", "!.gourdai/**"]
    },
    {
      "from": "build/ui/",
      "to": "ui"
    },
    {
      "from": "build/icons/",
      "to": "icons"
    }
  ],
  "win": {
    "icon": "build/icons/icon.ico",
    "forceCodeSigning": false,
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/icons/icon.ico",
    "uninstallerIcon": "build/icons/icon.ico",
    "shortcutName": "GWork",
    "include": "cmd/installer.nsh"
  }
}
